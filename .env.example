# Copie este archivo a .env y ajuste los valores. NUNCA suba .env al repositorio.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Identidad y agenda
PARISH_NAME=Parroquia San Jose
APP_TIMEZONE=America/Bogota

# Base de datos (archivo SQLite). Debe estar en un disco con copias de seguridad.
DB_FILE=./data/citas.db

# Reglas de agendamiento
MIN_LEAD_HOURS=12
MAX_DAYS_AHEAD=60
MAX_PENDING_PER_EMAIL=3
# Dias tras los cuales se anonimizan los datos personales de citas pasadas
RETENTION_DAYS=540

# Seguridad
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
BOOKING_MAX_PER_HOUR=5
# true SOLO si el sitio se sirve por HTTPS
SECURE_COOKIES=true
# true SOLO si hay un proxy inverso propio (Nginx/Caddy/Cloudflare) delante
TRUST_PROXY=true
# Dominios propios permitidos para operaciones de escritura
ALLOWED_ORIGINS=https://citas.miparroquia.org
# Sal para anonimizar direcciones IP en el registro (cadena aleatoria larga)
IP_SALT=cambie-esto-por-una-cadena-aleatoria-larga

# Contrasenas iniciales para el script de datos de ejemplo (opcional)
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_LIDER=
